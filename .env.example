# Optional settings read by scripts/dev-backend.sh.
# Copy to .env and uncomment the settings you want to change.
# Use unquoted KEY=value. A relative database path starts in backend/.
# TRACKER_DB_PATH=data/tracker.sqlite
# TRACKER_TIME_ZONE=Asia/Kolkata
# TRACKER_BACKUP_ROOT=/absolute/path/outside/the/repository

# Docker Compose reads TRACKER_TIME_ZONE and the optional MCP switch.
# TRACKER_MCP_ENABLED=true
# Docker uses named volumes at /data and /backups for the database and backups.
